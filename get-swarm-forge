#!/bin/zsh
set -euo pipefail

# This fork composes a Forgelet forge: the shared runtime and shared articles come
# from its own branch, and a pack that the family carries its own copy of comes
# from that pack's own fork, on the branch below. Everything is overridable, so
# the helper still installs Uncle Bob's products when asked to.
default_repo_url="https://github.com/sgo/forgelet-swarmforge"
base_ref="${SWARMFORGE_BASE_REF:-forgelet}"
pack_names=(two-pack four-pack six-pack)

# The packs the family carries its own copy of. Each is a repository of its own,
# forked the way this layer is: `main` mirrors the upstream pack branch
# (unclebob/swarm-forge), and this branch holds ours - one rule of the family's
# beside everything upstream's, so an upstream change merges into main and lands
# here beside it. A pack with no repository named here comes from this layer's
# own branch, as it always has. Both the branch and each repository are
# overridable, for a forge that wants Uncle Bob's packs untouched.
pack_ref="${SWARMFORGE_PACK_REF:-forgelet}"

pack_repo() {
  local name="$1"
  case "$name" in
    six-pack) echo "${SWARMFORGE_SIX_PACK_REPO:-https://github.com/sgo/forgelet-six-pack}" ;;
    four-pack) echo "${SWARMFORGE_FOUR_PACK_REPO:-https://github.com/sgo/forgelet-four-pack}" ;;
  esac
}

usage() {
  # Where this fork documents itself, derived rather than written down, so an
  # override that composes from another repository or branch points at that
  # one's README instead of at a page that does not describe what just happened.
  local doc_url="${SWARMFORGE_REPO_URL:-$default_repo_url}/blob/$base_ref/README.md"
  echo "usage: get-swarm-forge <two-pack|four-pack|six-pack|project-manager|lieutenant>" >&2
  echo "  Packs (two-pack, four-pack, six-pack) compose into the current directory." >&2
  echo "  project-manager and lieutenant are forges (projects/, dashboard, host lieutenant)." >&2
  echo "" >&2
  echo "  This is the Forgelet fork: the shared runtime comes from its forgelet branch," >&2
  echo "  on top of SwarmForge. What that layer is, and where a forge's own things go -" >&2
  echo "  swarmforge/local-scripts/, local-lieutenant.prompt, a project's language.conf -" >&2
  echo "  is documented at:" >&2
  echo "    $doc_url" >&2
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -ne 1 || "$1" == -* ]]; then
  usage
  exit 1
fi

product="$1"
case "$product" in
  two-pack|four-pack|six-pack|project-manager|lieutenant) ;;
  *)
    echo "get-swarm-forge: unknown product '$product'" >&2
    usage
    exit 1
    ;;
esac

repo_url="${SWARMFORGE_REPO_URL:-$default_repo_url}"

# The arguments this run was started with, so a self-update can start it again as
# the fetched copy rather than as itself - and this script's own path, because zsh
# sets $0 to the function's name inside a function.
original_args=("$@")
script_path="${0:A}"

# Scratch lives under the compose target's own tmp/, because that is the rule every
# role here follows - write scratch in ./tmp/, never /tmp - and because a compose
# that failed should leave something a person can look at. It is a fresh directory
# per run, so nothing stale is ever read back, and it is removed only when the run
# succeeded.
tmp_dir="$PWD/tmp/swarmforge-compose-$(date +%Y%m%dT%H%M%S)-$$"
mkdir -p "$tmp_dir" 2>/dev/null || tmp_dir="$(mktemp -d)"

cleanup() {
  # `status` is read-only in zsh, so the code is its own name.
  local code=$?
  if [[ -d "$tmp_dir" ]]; then
    if [[ $code -eq 0 ]]; then
      rm -rf "$tmp_dir"
    else
      echo "get-swarm-forge: failed, and left its scratch at $tmp_dir" >&2
    fi
  fi
}
trap cleanup EXIT

# The helper is installed as a copy, so a change to it only reaches a machine that
# installs it again - and nothing on that machine says the copy has gone stale. It
# downloads the layer it is about to compose from anyway, and that layer carries the
# helper's own file at its root, so a difference means this copy is the older one:
# the layer is the source. It is replaced, and the run starts again as the new copy
# rather than carrying on half-old. A copy that cannot be replaced says so and the
# run continues, because failing to update yourself is not a reason to fail a compose;
# SWARMFORGE_NO_SELF_UPDATE=1 turns the whole thing off while the helper is being
# worked on, which is exactly when a copy on PATH is the right thing to edit.
maybe-update-self() {
  local layer="$1"
  [[ -n "$layer" && -d "$layer" ]] || return 0
  [[ -z "${SWARMFORGE_NO_SELF_UPDATE:-}" ]] || return 0
  [[ -z "${SWARMFORGE_SELF_UPDATED:-}" ]] || return 0
  local mine="$script_path"
  local theirs="$layer/get-swarm-forge"
  [[ -f "$theirs" ]] || return 0
  cmp -s "$mine" "$theirs" && return 0
  if ! cp "$theirs" "$mine" 2>/dev/null; then
    echo "get-swarm-forge: the layer carries a newer helper at $theirs, and this copy ($mine) cannot be replaced; install it again with the command in ${SWARMFORGE_REPO_URL:-$default_repo_url}/blob/$base_ref/README.md" >&2
    return 0
  fi
  echo "get-swarm-forge: replaced itself with the helper from ${base_ref} and starting again"
  rm -rf "$tmp_dir"
  SWARMFORGE_SOURCE_COMMIT="$composed_layer_commit" \
    SWARMFORGE_SELF_UPDATED=1 exec "$mine" "${original_args[@]}"
}

local_git_dir() {
  if [[ -v SWARMFORGE_GIT_DIR ]]; then
    echo "$SWARMFORGE_GIT_DIR"
  fi
}

try_download_branch() {
  local ref="$1"
  local dest="$2"
  # The third argument is the repository to ask, for a pack that lives in its own
  # fork rather than in this layer.
  local from="${3:-$repo_url}"
  local url="${from}/archive/refs/heads/${ref}.tar.gz"
  local tar_path="$tmp_dir/${ref}.tgz"
  local git_dir
  mkdir -p "$dest"
  if curl -fsSL "$url" -o "$tar_path"; then
    tar -xz --strip-components=1 -C "$dest" -f "$tar_path"
    return 0
  fi
  git_dir="$(local_git_dir)"
  if [[ -n "$git_dir" && -d "$git_dir/.git" ]] \
       && git -C "$git_dir" show-ref --verify --quiet "refs/heads/$ref"; then
    echo "get-swarm-forge: GitHub has no branch '$ref'; using $git_dir" >&2
    git -C "$git_dir" archive --format=tar "$ref" | tar -x -C "$dest"
    return 0
  fi
  return 1
}

download_branch() {
  local ref="$1"
  local dest="$2"
  local from="${3:-$repo_url}"
  if try_download_branch "$ref" "$dest" "$from"; then
    return
  fi
  echo "get-swarm-forge: branch '$ref' was not found at ${from}/archive/refs/heads/${ref}.tar.gz" >&2
  echo "Push the branch, or set SWARMFORGE_GIT_DIR to a local checkout that has it." >&2
  exit 1
}

fail_missing() {
  local missing_path="$1"
  echo "get-swarm-forge: missing required file after composing swarm: $missing_path" >&2
  exit 1
}

copy_shared_scripts_and_articles() {
  local src="$1"
  local preserved_adapter=""
  [[ -d "$src/swarmforge/scripts" ]] || fail_missing "swarmforge/scripts from $src"
  [[ -d "$src/swarmforge/constitution/articles" ]] || fail_missing "swarmforge/constitution/articles from $src"
  mkdir -p swarmforge/constitution/articles
  # A bridge is installed by its own repository. Once composition is told to
  # leave bridge installation alone, the layer's fallback adapter must not
  # quietly replace the adapter the bridge installed in this forge.
  if [[ -n "${SWARMFORGE_SKIP_BRIDGE:-}" \
        && -f swarmforge/scripts/matrix-bridge.sh ]]; then
    preserved_adapter="$tmp_dir/matrix-bridge.sh.preserved"
    cp -p swarmforge/scripts/matrix-bridge.sh "$preserved_adapter"
  fi
  rm -rf swarmforge/scripts
  cp -R "$src/swarmforge/scripts" swarmforge/scripts
  if [[ -n "$preserved_adapter" ]]; then
    cp -p "$preserved_adapter" swarmforge/scripts/matrix-bridge.sh
  fi
  local shared_article
  for shared_article in engineering.prompt workflow.prompt handoffs.prompt privacy.prompt stopping-without-finishing.prompt; do
    [[ -f "$src/swarmforge/constitution/articles/$shared_article" ]] \
      && cp "$src/swarmforge/constitution/articles/$shared_article" \
           "swarmforge/constitution/articles/$shared_article"
  done
}

# The lieutenant's instructions are the layer's own. A product branch carries
# upstream's skeleton for them, and this fork's rules - the answering rule, the
# gate, the backlog discipline, the routing gate, the completion duties - are what
# a Forgelet forge runs, so the layer's copy wins, the way the shared articles do.
overlay_lieutenant_prompt() {
  local src prompt
  for src in "$@"; do
    prompt="$src/swarmforge/roles/lieutenant.prompt"
    [[ -f "$prompt" ]] || continue
    mkdir -p swarmforge/roles
    cp "$prompt" swarmforge/roles/lieutenant.prompt
  done
}

# Whatever this forge adds to those instructions lives beside them, in a file the
# composition never writes once it exists: the layer's copy seeds it, so a fresh
# forge arrives with the shape, and a forge that has written its own keeps it.
seed_local_lieutenant_prompt() {
  local src seeded
  for src in "$@"; do
    seeded="$src/swarmforge/roles/local-lieutenant.prompt"
    [[ -f "$seeded" ]] || continue
    mkdir -p swarmforge/roles
    [[ -f swarmforge/roles/local-lieutenant.prompt ]] \
      || cp "$seeded" swarmforge/roles/local-lieutenant.prompt
  done
}

# The family's own skills travel with the layer, so every forge learns the same
# conventions - how a forge asks another for work by issue, and whatever else the
# layer carries beside it. Only the skills the layer carries are replaced: a forge
# that has written one of its own keeps it, because the wholesale replace the
# shared scripts get would eat it, and a forge's own tooling is not the layer's to
# delete.
copy_shared_skills() {
  local src="$1" skill name
  [[ -d "$src/swarmforge/skills" ]] || return 0
  mkdir -p swarmforge/skills .agents/skills
  for skill in "$src/swarmforge/skills"/*; do
    [[ -d "$skill" ]] || continue
    name="${skill:t}"
    rm -rf "swarmforge/skills/$name"
    cp -R "$skill" "swarmforge/skills/$name"
    if [[ -e ".agents/skills/$name" && ! -L ".agents/skills/$name" ]]; then
      echo "get-swarm-forge: refusing to replace forge-owned skill .agents/skills/$name" >&2
      exit 1
    fi
    ln -sfn "../../swarmforge/skills/$name" ".agents/skills/$name"
  done
}

copy_shared_runtime() {
  local src="$1"
  copy_shared_scripts_and_articles "$src"
  copy_shared_skills "$src"
  [[ -f "$src/swarm" ]] && cp "$src/swarm" swarm
  [[ -f "$src/swarmforge/constitution.prompt" ]] \
    && cp "$src/swarmforge/constitution.prompt" swarmforge/constitution.prompt
  [[ -f "$src/swarmforge/roles/lieutenant.prompt" ]] \
    && cp "$src/swarmforge/roles/lieutenant.prompt" swarmforge/roles/lieutenant.prompt
}

copy_host_files() {
  local src="$1"
  copy_shared_scripts_and_articles "$src"
  copy_shared_skills "$src"
  [[ -f "$src/swarmforge/constitution.prompt" ]] \
    && cp "$src/swarmforge/constitution.prompt" swarmforge/constitution.prompt
  mkdir -p swarmforge/roles
  [[ -f "$src/swarmforge/roles/lieutenant.prompt" ]] \
    && cp "$src/swarmforge/roles/lieutenant.prompt" swarmforge/roles/lieutenant.prompt
  if [[ ! -f swarmforge/swarmforge.conf && -f "$src/swarmforge/swarmforge.conf" ]]; then
    cp "$src/swarmforge/swarmforge.conf" swarmforge/swarmforge.conf
  fi
  if [[ -f "$src/swarm" ]]; then
    cp "$src/swarm" swarm
  elif [[ ! -f swarm ]]; then
    cat > swarm <<'WRAP'
#!/bin/zsh
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$SCRIPT_DIR/swarmforge/scripts/swarmforge.sh" "$@"
WRAP
  fi
  chmod +x swarm
}

copy_pack_template() {
  local src="$1"
  local dest="$2"
  mkdir -p "$dest/swarmforge"
  [[ -f "$src/swarm" ]] && cp "$src/swarm" "$dest/swarm"
  [[ -f "$src/swarmforge/swarmforge.conf" ]] || fail_missing "swarmforge/swarmforge.conf in pack"
  [[ -d "$src/swarmforge/roles" ]] || fail_missing "swarmforge/roles in pack"
  cp "$src/swarmforge/swarmforge.conf" "$dest/swarmforge/swarmforge.conf"
  [[ -f "$src/swarmforge/constitution.prompt" ]] \
    && cp "$src/swarmforge/constitution.prompt" "$dest/swarmforge/constitution.prompt"
  rm -rf "$dest/swarmforge/roles"
  cp -R "$src/swarmforge/roles" "$dest/swarmforge/roles"
  mkdir -p "$dest/swarmforge/constitution/articles"
  if [[ -d "$src/swarmforge/constitution/articles" ]]; then
    for pack_article in "$src/swarmforge/constitution/articles"/*; do
      [[ -f "$pack_article" ]] || continue
      article_name="${pack_article:t}"
      case "$article_name" in
        engineering.prompt|workflow.prompt|handoffs.prompt|privacy.prompt|stopping-without-finishing.prompt) continue ;;
      esac
      cp "$pack_article" "$dest/swarmforge/constitution/articles/$article_name"
    done
  fi
}

# The lines a project composed from a pack needs git to leave alone - the
# language's build output, so that never becomes the first commit, and the
# host's own noise. A pack branch stays a mirror of upstream, so a Forgelet forge
# carries them here instead, under the pack's own name, and writes them where
# composition reads them: the forge.bb overlay merges a pack's `gitignore` into a
# project's .gitignore without replacing what the project put there. Lines are
# merged rather than copied so a forge-side file that already has them stays as
# it is.
merge_ignore_lines() {
  local src="$1"
  local dest="$2"
  [[ -f "$src" ]] || return 0
  [[ -f "$dest" ]] || : > "$dest"
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    grep -qxF "$line" "$dest" || printf '%s\n' "$line" >> "$dest"
  done < "$src"
}

source_commit_re='^[0-9a-f]{40}$'

fail_source() {
  echo "get-swarm-forge: $1" >&2
  exit 1
}

validate_source_selection() {
  local declared="${SWARMFORGE_SOURCE_COMMIT:-}"
  local base="${SWARMFORGE_BASE_DIR:-}"
  local git_dir
  git_dir="$(local_git_dir)"

  if [[ -n "$base" && -n "$git_dir" ]]; then
    fail_source "SWARMFORGE_BASE_DIR and SWARMFORGE_GIT_DIR select different layer sources; set only one, or leave both unset to use the published $base_ref branch"
  fi
  if [[ -n "$declared" && ! "$declared" =~ $source_commit_re ]]; then
    fail_source "SWARMFORGE_SOURCE_COMMIT must be a 40-character lowercase Git commit"
  fi
  if [[ -n "$git_dir" ]]; then
    [[ -d "$git_dir/.git" ]] \
      || fail_source "SWARMFORGE_GIT_DIR is not a Git checkout: $git_dir"
    if [[ -n "$declared" ]] \
         && ! git -C "$git_dir" cat-file -e "$declared^{commit}" 2>/dev/null; then
      fail_source "SWARMFORGE_SOURCE_COMMIT $declared is not present in SWARMFORGE_GIT_DIR"
    fi
  fi
  if [[ -n "$base" && ! -d "$base" ]]; then
    fail_source "SWARMFORGE_BASE_DIR is not a directory: $base"
  fi
  if [[ -n "$base" && ! -d "$base/.git" \
        && -f "$base/swarmforge/scripts/forge_runtime_upgrade.bb" ]]; then
    fail_source "SWARMFORGE_BASE_DIR must be a Git checkout so the runtime manifest can name one exact source commit; set SWARMFORGE_GIT_DIR to that checkout or use the published branch"
  fi
}

resolve_layer_commit() {
  local declared="${SWARMFORGE_SOURCE_COMMIT:-}"
  local base="${SWARMFORGE_BASE_DIR:-}"
  local git_dir commit
  git_dir="$(local_git_dir)"

  if [[ -n "$declared" ]]; then
    echo "$declared"
    return
  fi
  if [[ -n "$git_dir" ]]; then
    commit="$(git -C "$git_dir" rev-parse "refs/heads/$base_ref^{commit}" 2>/dev/null || true)"
  elif [[ -n "$base" && -d "$base/.git" ]]; then
    commit="$(git -C "$base" rev-parse "HEAD^{commit}" 2>/dev/null || true)"
  elif [[ -z "$base" ]]; then
    commit="$(git ls-remote "$repo_url" "refs/heads/$base_ref" 2>/dev/null \
      | awk 'NR == 1 { print $1 }')"
  elif [[ ! -f "$base/swarmforge/scripts/forge_runtime_upgrade.bb" ]]; then
    return
  fi
  if [[ ! "$commit" =~ $source_commit_re ]]; then
    fail_source "could not resolve one canonical commit for the $base_ref layer"
  fi
  echo "$commit"
}

verify_git_source_commit() {
  local git_dir="$1" commit="$2" head dirty
  head="$(git -C "$git_dir" rev-parse HEAD 2>/dev/null || true)"
  [[ "$head" == "$commit" ]] \
    || fail_source "local layer checkout is at ${head:-an unknown commit}, not the requested source commit $commit"
  dirty="$(git -C "$git_dir" status --porcelain --untracked-files=no \
    -- swarm swarmforge 2>/dev/null)"
  [[ -z "$dirty" ]] \
    || fail_source "local layer checkout has uncommitted runtime changes; commit them before composing so the manifest and files name the same source"
}

verify_layer_identity() {
  local layer="$1" commit="$2" actual=""
  if [[ -d "$layer/.git" ]]; then
    actual="$(git -C "$layer" rev-parse HEAD 2>/dev/null || true)"
  elif [[ -f "$layer/.swarmforge-source-commit" ]]; then
    actual="$(<"$layer/.swarmforge-source-commit")"
  fi
  [[ "$actual" == "$commit" ]] \
    || fail_source "composed layer identity is ${actual:-missing}, not the resolved source commit $commit"
}

download_layer_commit() {
  local dest="$1" commit="$2" git_dir
  git_dir="$(local_git_dir)"
  mkdir -p "$dest"
  if [[ -n "$git_dir" ]]; then
    git -C "$git_dir" archive --format=tar "$commit" | tar -x -C "$dest"
  else
    git init -q "$dest"
    git -C "$dest" remote add origin "$repo_url"
    git -C "$dest" fetch --quiet --depth=1 origin "$commit" \
      || fail_source "the exact layer commit $commit was not available from $repo_url"
    git -C "$dest" checkout -q --detach FETCH_HEAD \
      || fail_source "the exact layer commit $commit could not be checked out"
  fi
  printf '%s\n' "$commit" > "$dest/.swarmforge-source-commit"
  verify_layer_identity "$dest" "$commit"
}

compare_runtime_file() {
  local layer="$1" relative="$2"
  [[ -f "$layer/$relative" ]] || fail_source "the resolved layer is missing runtime file $relative"
  [[ -f "$PWD/$relative" ]] || fail_source "composition did not install runtime file $relative"
  cmp -s "$layer/$relative" "$PWD/$relative" \
    || fail_source "installed runtime file $relative does not match source commit $composed_layer_commit"
}

compare_runtime_tree() {
  local layer="$1" relative_root="$2" file relative
  [[ -d "$layer/$relative_root" ]] || return 0
  while IFS= read -r -d '' file; do
    relative="${file#$layer/}"
    [[ "$relative" == "swarmforge/scripts/matrix-bridge.sh" ]] && continue
    compare_runtime_file "$layer" "$relative"
  done < <(find "$layer/$relative_root" -type f -print0)
}

verify_composed_runtime() {
  local layer="$1" relative
  verify_layer_identity "$layer" "$composed_layer_commit"
  for relative in \
    swarm \
    swarmforge/constitution.prompt \
    swarmforge/roles/lieutenant.prompt \
    swarmforge/constitution/articles/engineering.prompt \
    swarmforge/constitution/articles/workflow.prompt \
    swarmforge/constitution/articles/handoffs.prompt \
    swarmforge/constitution/articles/privacy.prompt \
    swarmforge/constitution/articles/stopping-without-finishing.prompt; do
    compare_runtime_file "$layer" "$relative"
  done
  compare_runtime_tree "$layer" swarmforge/scripts
  compare_runtime_tree "$layer" swarmforge/skills
}

write_runtime_manifest() {
  local layer="${1:-$main_dir}"
  local helper="$layer/swarmforge/scripts/forge_runtime_upgrade.bb"
  [[ -f "$helper" ]] || return 0
  local manifest_commit
  [[ "$composed_layer_commit" =~ $source_commit_re ]] \
    || fail_missing "canonical source commit for the composed runtime manifest"
  verify_composed_runtime "$layer"
  bb "$helper" manifest --forge "$PWD" --source-layer "$layer" \
    --product "$product" --source-commit "$composed_layer_commit"
  manifest_commit="$(bb -e \
    '(require (quote [clojure.edn :as edn]))
     (print (:source_commit
             (edn/read-string
              (slurp (first *command-line-args*)))))' \
    "$PWD/.swarmforge/runtime-manifest.edn")"
  [[ "$manifest_commit" == "$composed_layer_commit" ]] \
    || fail_source "runtime manifest records ${manifest_commit:-no source commit}, not resolved source commit $composed_layer_commit"
}

install_pack_ignores() {
  local src pack_name
  for src in "$@"; do
    for pack_name in "${pack_names[@]}"; do
      merge_ignore_lines "$src/swarmforge/packs/$pack_name/gitignore" \
                         "packs/$pack_name/gitignore"
      # And the lines every project needs whichever pack it is composed from -
      # the host's own noise, which no language and no pack brings with it. They
      # are carried once, beside the packs, and merged into each pack's list here
      # so a pack whose language writes nothing at the root still ignores them,
      # and a pack added later needs no reminder.
      merge_ignore_lines "$src/swarmforge/packs/gitignore" \
                         "packs/$pack_name/gitignore"
    done
  done
}

verify_pack_roles() {
  local dest="$1"
  [[ -f "$dest/swarmforge/swarmforge.conf" ]] || fail_missing "$dest/swarmforge/swarmforge.conf"
  while IFS= read -r role; do
    [[ -f "$dest/swarmforge/roles/${role}.prompt" ]] \
      || fail_missing "$dest/swarmforge/roles/${role}.prompt"
  done < <(awk '/^window/ { print $2 }' "$dest/swarmforge/swarmforge.conf")
}

pack_tree() {
  local name="$1"
  if [[ -n "$packs_src" && -d "$packs_src/$name" ]]; then
    echo "$packs_src/$name"
  elif [[ -n "$packs_src" && -f "$packs_src/swarmforge/swarmforge.conf" ]]; then
    echo "$packs_src"
  else
    echo ""
  fi
}

install_project_pack() {
  local pack_src
  pack_src="$(pack_tree "$product")"
  if [[ -z "$pack_src" && -d "$host_dir/.swarmforge/project-pack" ]]; then
    pack_src="$host_dir/.swarmforge/project-pack"
  fi
  [[ -n "$pack_src" && -d "$pack_src" ]] || fail_missing ".swarmforge/project-pack"
  mkdir -p .swarmforge/project-pack
  copy_pack_template "$pack_src" ".swarmforge/project-pack"
  verify_pack_roles ".swarmforge/project-pack"
}

install_named_packs() {
  mkdir -p packs
  local pack_name pack_src pack_from
  for pack_name in "${pack_names[@]}"; do
    pack_src="$(pack_tree "$pack_name")"
    if [[ -z "$pack_src" ]]; then
      pack_src="$tmp_dir/packs/$pack_name"
      # A pack the family carries its own copy of comes from its own fork, on
      # pack_ref; anything else comes from this layer's branch of the same name.
      pack_from="$(pack_repo "$pack_name")"
      if [[ -n "$pack_from" ]]; then
        download_branch "$pack_ref" "$pack_src" "$pack_from"
      else
        download_branch "$pack_name" "$pack_src"
      fi
    fi
    [[ -n "$pack_src" && -d "$pack_src" ]] || fail_missing "pack $pack_name"
    copy_pack_template "$pack_src" "packs/$pack_name"
    verify_pack_roles "packs/$pack_name"
  done
}

require_files() {
  local required_path
  for required_path in "$@"; do
    [[ -e "$required_path" ]] || fail_missing "$required_path"
  done
}

# A Forgelet forge arrives able to talk to a phone. This fork builds the bridge on
# the machine that will run it - no cross-compilation, no published binaries - and
# installs the tools and rules the bridge's rooms rely on into the forge.
bridge_repo_url="${SWARMFORGE_BRIDGE_REPO:-https://github.com/sgo/forgelet-bridge}"
bridge_ref="${SWARMFORGE_BRIDGE_REF:-master}"
bridge_source="${SWARMFORGE_BRIDGE_DIR:-}"

bridge_tarball() {
  local dest="$1"
  local tar="$tmp_dir/forgelet-bridge.tar.gz"
  local url="${bridge_repo_url}/archive/refs/heads/${bridge_ref}.tar.gz"
  mkdir -p "$dest"
  if ! curl -fsSL "$url" -o "$tar" 2>/dev/null; then
    # A private repository needs a token, and gh has one when it is signed in.
    if command -v gh >/dev/null 2>&1 && gh auth token >/dev/null 2>&1; then
      curl -fsSL -H "Authorization: Bearer $(gh auth token)" "$url" -o "$tar" \
        || fail_missing "the bridge at $url"
    else
      fail_missing "the bridge at $url (make the repository public, or sign in with gh)"
    fi
  fi
  tar -xzf "$tar" --strip-components=1 -C "$dest"
}

build_forgelet_bridge() {
  local dest="$1"
  if [[ -n "$bridge_source" ]]; then
    mkdir -p "$dest"
    cp -R "$bridge_source/." "$dest"
  else
    bridge_tarball "$dest"
  fi
  [[ -f "$dest/scripts/build.sh" ]] || fail_missing "the bridge's build script in $dest"
  command -v go >/dev/null 2>&1 \
    || fail_missing "go (a Forgelet forge builds the bridge it runs)"
  # The bridge is built from a downloaded archive, not a Git checkout. Go 1.27's
  # automatic VCS stamping otherwise fails while asking git about that scratch
  # tree, aborting composition before the new forge can be started.
  (cd "$dest" && GOFLAGS="${GOFLAGS:+$GOFLAGS }-buildvcs=false" \
    ./scripts/build.sh >/dev/null) || fail_missing "the bridge's build"
}

install_forgelet_bridge() {
  if [[ -n "${SWARMFORGE_SKIP_BRIDGE:-}" ]]; then
    return 0
  fi
  local root="$PWD"
  local installed="projects/forgelet-bridge"
  local source="$tmp_dir/forgelet-bridge"
  # The kit comes from the published bridge, freshly fetched and built, and never
  # from this forge's own projects/forgelet-bridge: that tree is a live project -
  # its own history, its own work in it - while what a forge installs is the code
  # the bridge runs, which is the code the bridge pushes.
  build_forgelet_bridge "$source"
  if [[ ! -d "$installed/.git" ]]; then
    mkdir -p "$installed"
    local part
    for part in build swarmforge rules; do
      [[ -e "$source/$part" ]] || continue
      mkdir -p "$installed/$part"
      cp -R "$source/$part/." "$installed/$part/"
    done
  fi
  if [[ -f "$source/scripts/matrix-bridge.sh" ]]; then
    mkdir -p swarmforge/scripts
    cp "$source/scripts/matrix-bridge.sh" swarmforge/scripts/matrix-bridge.sh
    chmod +x swarmforge/scripts/matrix-bridge.sh
  fi
  local adapter="swarmforge/scripts/matrix-bridge.sh"
  [[ -x "$adapter" ]] || fail_missing "the bridge's adapter at $adapter"
  local kit_binary="$source/build/acceptance/bin/install-kit"
  local kit_dir="$source/swarmforge/scripts"
  local rules_binary="$source/build/acceptance/bin/install-rules"
  local rules_dir="$source/rules"
  local revision=""
  if [[ -d "$source/.git" ]]; then
    revision="$(git -C "$source" rev-parse --short HEAD 2>/dev/null || true)"
  fi
  echo "get-swarm-forge: installing the kit from ${bridge_ref}${revision:+ at $revision}"
  MATRIX_BRIDGE_FORGE_ROOT="$root" \
  MATRIX_BRIDGE_KIT_BINARY="$kit_binary" \
  MATRIX_BRIDGE_KIT="$kit_dir" \
  MATRIX_BRIDGE_RULES_BINARY="$rules_binary" \
  MATRIX_BRIDGE_RULES="$rules_dir" \
    "$adapter" install-kit
  MATRIX_BRIDGE_FORGE_ROOT="$root" \
  MATRIX_BRIDGE_KIT_BINARY="$kit_binary" \
  MATRIX_BRIDGE_KIT="$kit_dir" \
  MATRIX_BRIDGE_RULES_BINARY="$rules_binary" \
  MATRIX_BRIDGE_RULES="$rules_dir" \
    "$adapter" install-rules
}

restore_layer_runtime() {
  local src="$1"
  local adapter=""
  if [[ -f swarmforge/scripts/matrix-bridge.sh ]]; then
    adapter="$tmp_dir/matrix-bridge.sh.installed"
    cp -p swarmforge/scripts/matrix-bridge.sh "$adapter"
  fi
  copy_shared_runtime "$src"
  if [[ -n "$adapter" ]]; then
    cp -p "$adapter" swarmforge/scripts/matrix-bridge.sh
  fi
  chmod +x swarm
}

validate_source_selection
composed_layer_commit="$(resolve_layer_commit)"

host_dir="${SWARMFORGE_BASE_DIR:-$tmp_dir/host}"
host_from="$product"
packs_src="${SWARMFORGE_PACKS_DIR:-}"
main_dir="$tmp_dir/main"

if [[ "$product" == two-pack || "$product" == four-pack || "$product" == six-pack ]]; then
  if [[ -z "${SWARMFORGE_BASE_DIR:-}" ]]; then
    download_layer_commit "$main_dir" "$composed_layer_commit"
    host_dir="$main_dir"
  fi
  maybe-update-self "$main_dir"
  pack_src="$(pack_tree "$product")"
  if [[ -z "$pack_src" ]]; then
    pack_src="$tmp_dir/pack"
    pack_from="$(pack_repo "$product")"
    if [[ -n "$pack_from" ]]; then
      download_branch "$pack_ref" "$pack_src" "$pack_from"
    else
      download_branch "$product" "$pack_src"
    fi
  fi
  [[ -n "$pack_src" && -d "$pack_src" ]] || fail_missing "pack $product"
  copy_pack_template "$pack_src" "."
  copy_shared_runtime "$host_dir"
  merge_ignore_lines "$host_dir/swarmforge/packs/$product/gitignore" ".gitignore"
  [[ -f swarm ]] || fail_missing "swarm from pack $product"
  chmod +x swarm
  verify_pack_roles "."
  require_files \
    swarm \
    swarmforge/scripts/swarmforge.sh \
    swarmforge/scripts/handoffd.bb \
    swarmforge/scripts/done_with_current.sh \
    swarmforge/constitution/articles/handoffs.prompt \
    swarmforge/constitution/articles/workflow.prompt \
    swarmforge/constitution/articles/engineering.prompt \
    swarmforge/swarmforge.conf \
    swarmforge/constitution.prompt
  write_runtime_manifest "$host_dir"
  echo "SwarmForge pack installed from $product. Run ./swarm to start the pack."
  exit 0
fi

if [[ -z "${SWARMFORGE_BASE_DIR:-}" ]]; then
  download_branch "$product" "$host_dir"
  download_layer_commit "$main_dir" "$composed_layer_commit"
fi

layer_dir="$main_dir"
[[ -n "${SWARMFORGE_BASE_DIR:-}" ]] && layer_dir="$host_dir"

if [[ -d "$layer_dir/.git" && -z "${SWARMFORGE_GIT_DIR:-}" ]]; then
  verify_git_source_commit "$layer_dir" "$composed_layer_commit"
fi

maybe-update-self "$main_dir"

mkdir -p projects
copy_host_files "$host_dir"

# A forge product branch carries its own copy of the shared runtime, which is
# whatever it was when that branch was last refreshed. The resolved layer is
# overlaid last and wins for every shared runtime file: the product keeps its
# configuration, roles, and scaffolding.
copy_shared_runtime "$layer_dir"

overlay_lieutenant_prompt "$host_dir" "$main_dir"
seed_local_lieutenant_prompt "$host_dir" "$main_dir"

if [[ "$product" == "lieutenant" ]]; then
  install_project_pack
else
  install_named_packs
  install_pack_ignores "$main_dir" "$host_dir"
  # No language default comes with the packs. What a project is written in is the
  # project's decision - written once into its own swarmforge/language.conf, seeded at
  # most from the pack it was composed from. A default that lives here is shared by
  # every forge this layer feeds, and they are not all written in the same language: a
  # Java project composed from a pack this layer had given "Kotlin" would read the
  # wrong rules without anyone choosing that.
fi

required_files=(
  swarm
  swarmforge/scripts/swarmforge.sh
  swarmforge/scripts/handoffd.bb
  swarmforge/scripts/done_with_current.sh
  swarmforge/scripts/route_card.sh
  swarmforge/scripts/route_card.bb
  swarmforge/scripts/install-agent-credentials.sh
  swarmforge/constitution/articles/handoffs.prompt
  swarmforge/constitution/articles/workflow.prompt
  swarmforge/constitution/articles/engineering.prompt
  swarmforge/roles/lieutenant.prompt
)

if [[ "$product" == "lieutenant" ]]; then
  required_files+=(.swarmforge/project-pack/swarmforge/swarmforge.conf)
else
  required_files+=(
    packs/two-pack/swarmforge/swarmforge.conf
    packs/four-pack/swarmforge/swarmforge.conf
    packs/six-pack/swarmforge/swarmforge.conf
  )
fi

require_files "${required_files[@]}"

install_forgelet_bridge
restore_layer_runtime "$layer_dir"
write_runtime_manifest "$layer_dir"

echo "SwarmForge forge installed from $host_from. Run ./swarm to start the dashboard."
