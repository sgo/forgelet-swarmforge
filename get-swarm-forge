#!/bin/zsh
set -euo pipefail

# This fork composes a Forgelet forge: the shared runtime and shared articles come
# from its own branch, and the packs come from the same repository. Both are
# overridable, so the helper still installs Uncle Bob's products when asked to.
default_repo_url="https://github.com/sgo/forgelet-swarmforge"
base_ref="${SWARMFORGE_BASE_REF:-forgelet}"
pack_names=(two-pack four-pack six-pack)

usage() {
  echo "usage: get-swarm-forge <two-pack|four-pack|six-pack|project-manager|lieutenant>" >&2
  echo "  Packs (two-pack, four-pack, six-pack) compose into the current directory." >&2
  echo "  project-manager and lieutenant are forges (projects/, dashboard, host lieutenant)." >&2
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -ne 1 || "$1" == -* ]]; then
  usage
  exit 1
fi

product="$1"
case "$product" in
  two-pack|four-pack|six-pack|project-manager|lieutenant) ;;
  *)
    echo "get-swarm-forge: unknown product '$product'" >&2
    usage
    exit 1
    ;;
esac

repo_url="${SWARMFORGE_REPO_URL:-$default_repo_url}"

# The arguments this run was started with, so a self-update can start it again as
# the fetched copy rather than as itself - and this script's own path, because zsh
# sets $0 to the function's name inside a function.
original_args=("$@")
script_path="${0:A}"

# Scratch lives under the compose target's own tmp/, because that is the rule every
# role here follows - write scratch in ./tmp/, never /tmp - and because a compose
# that failed should leave something a person can look at. It is a fresh directory
# per run, so nothing stale is ever read back, and it is removed only when the run
# succeeded.
tmp_dir="$PWD/tmp/swarmforge-compose-$(date +%Y%m%dT%H%M%S)-$$"
mkdir -p "$tmp_dir" 2>/dev/null || tmp_dir="$(mktemp -d)"

cleanup() {
  # `status` is read-only in zsh, so the code is its own name.
  local code=$?
  if [[ -d "$tmp_dir" ]]; then
    if [[ $code -eq 0 ]]; then
      rm -rf "$tmp_dir"
    else
      echo "get-swarm-forge: failed, and left its scratch at $tmp_dir" >&2
    fi
  fi
}
trap cleanup EXIT

# The helper is installed as a copy, so a change to it only reaches a machine that
# installs it again - and nothing on that machine says the copy has gone stale. It
# downloads the layer it is about to compose from anyway, and that layer carries the
# helper's own file at its root, so a difference means this copy is the older one:
# the layer is the source. It is replaced, and the run starts again as the new copy
# rather than carrying on half-old. A copy that cannot be replaced says so and the
# run continues, because failing to update yourself is not a reason to fail a compose;
# SWARMFORGE_NO_SELF_UPDATE=1 turns the whole thing off while the helper is being
# worked on, which is exactly when a copy on PATH is the right thing to edit.
maybe-update-self() {
  local layer="$1"
  [[ -n "$layer" && -d "$layer" ]] || return 0
  [[ -z "${SWARMFORGE_NO_SELF_UPDATE:-}" ]] || return 0
  [[ -z "${SWARMFORGE_SELF_UPDATED:-}" ]] || return 0
  local mine="$script_path"
  local theirs="$layer/get-swarm-forge"
  [[ -f "$theirs" ]] || return 0
  cmp -s "$mine" "$theirs" && return 0
  if ! cp "$theirs" "$mine" 2>/dev/null; then
    echo "get-swarm-forge: the layer carries a newer helper at $theirs, and this copy ($mine) cannot be replaced; install it from the README's command" >&2
    return 0
  fi
  echo "get-swarm-forge: replaced itself with the helper from ${base_ref} and starting again"
  rm -rf "$tmp_dir"
  SWARMFORGE_SELF_UPDATED=1 exec "$mine" "${original_args[@]}"
}

local_git_dir() {
  if [[ -v SWARMFORGE_GIT_DIR ]]; then
    echo "$SWARMFORGE_GIT_DIR"
  elif [[ -d "$HOME/projects/swarm-forge/.git" ]]; then
    echo "$HOME/projects/swarm-forge"
  fi
}

try_download_branch() {
  local ref="$1"
  local dest="$2"
  local url="${repo_url}/archive/refs/heads/${ref}.tar.gz"
  local tar_path="$tmp_dir/${ref}.tgz"
  local git_dir
  mkdir -p "$dest"
  if curl -fsSL "$url" -o "$tar_path"; then
    tar -xz --strip-components=1 -C "$dest" -f "$tar_path"
    return 0
  fi
  git_dir="$(local_git_dir)"
  if [[ -n "$git_dir" && -d "$git_dir/.git" ]] \
       && git -C "$git_dir" show-ref --verify --quiet "refs/heads/$ref"; then
    echo "get-swarm-forge: GitHub has no branch '$ref'; using $git_dir" >&2
    git -C "$git_dir" archive --format=tar "$ref" | tar -x -C "$dest"
    return 0
  fi
  return 1
}

download_branch() {
  local ref="$1"
  local dest="$2"
  if try_download_branch "$ref" "$dest"; then
    return
  fi
  echo "get-swarm-forge: branch '$ref' was not found at ${repo_url}/archive/refs/heads/${ref}.tar.gz" >&2
  echo "Push the branch, or set SWARMFORGE_GIT_DIR to a local checkout that has it." >&2
  exit 1
}

fail_missing() {
  local missing_path="$1"
  echo "get-swarm-forge: missing required file after composing swarm: $missing_path" >&2
  exit 1
}

copy_shared_scripts_and_articles() {
  local src="$1"
  [[ -d "$src/swarmforge/scripts" ]] || fail_missing "swarmforge/scripts from $src"
  [[ -d "$src/swarmforge/constitution/articles" ]] || fail_missing "swarmforge/constitution/articles from $src"
  mkdir -p swarmforge/constitution/articles
  rm -rf swarmforge/scripts
  cp -R "$src/swarmforge/scripts" swarmforge/scripts
  local shared_article
  for shared_article in engineering.prompt workflow.prompt handoffs.prompt; do
    [[ -f "$src/swarmforge/constitution/articles/$shared_article" ]] \
      && cp "$src/swarmforge/constitution/articles/$shared_article" \
           "swarmforge/constitution/articles/$shared_article"
  done
}

# The lieutenant's instructions are the layer's own. A product branch carries
# upstream's skeleton for them, and this fork's rules - the answering rule, the
# gate, the backlog discipline, the routing gate, the completion duties - are what
# a Forgelet forge runs, so the layer's copy wins, the way the shared articles do.
overlay_lieutenant_prompt() {
  local src prompt
  for src in "$@"; do
    prompt="$src/swarmforge/roles/lieutenant.prompt"
    [[ -f "$prompt" ]] || continue
    mkdir -p swarmforge/roles
    cp "$prompt" swarmforge/roles/lieutenant.prompt
  done
}

# Whatever this forge adds to those instructions lives beside them, in a file the
# composition never writes once it exists: the layer's copy seeds it, so a fresh
# forge arrives with the shape, and a forge that has written its own keeps it.
seed_local_lieutenant_prompt() {
  local src seeded
  for src in "$@"; do
    seeded="$src/swarmforge/roles/local-lieutenant.prompt"
    [[ -f "$seeded" ]] || continue
    mkdir -p swarmforge/roles
    [[ -f swarmforge/roles/local-lieutenant.prompt ]] \
      || cp "$seeded" swarmforge/roles/local-lieutenant.prompt
  done
}

copy_host_files() {
  local src="$1"
  copy_shared_scripts_and_articles "$src"
  [[ -f "$src/swarmforge/constitution.prompt" ]] \
    && cp "$src/swarmforge/constitution.prompt" swarmforge/constitution.prompt
  mkdir -p swarmforge/roles
  [[ -f "$src/swarmforge/roles/lieutenant.prompt" ]] \
    && cp "$src/swarmforge/roles/lieutenant.prompt" swarmforge/roles/lieutenant.prompt
  if [[ ! -f swarmforge/swarmforge.conf && -f "$src/swarmforge/swarmforge.conf" ]]; then
    cp "$src/swarmforge/swarmforge.conf" swarmforge/swarmforge.conf
  fi
  if [[ -f "$src/swarm" ]]; then
    cp "$src/swarm" swarm
  elif [[ ! -f swarm ]]; then
    cat > swarm <<'WRAP'
#!/bin/zsh
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$SCRIPT_DIR/swarmforge/scripts/swarmforge.sh" "$@"
WRAP
  fi
  chmod +x swarm
}

copy_pack_template() {
  local src="$1"
  local dest="$2"
  mkdir -p "$dest/swarmforge"
  [[ -f "$src/swarm" ]] && cp "$src/swarm" "$dest/swarm"
  [[ -f "$src/swarmforge/swarmforge.conf" ]] || fail_missing "swarmforge/swarmforge.conf in pack"
  [[ -d "$src/swarmforge/roles" ]] || fail_missing "swarmforge/roles in pack"
  cp "$src/swarmforge/swarmforge.conf" "$dest/swarmforge/swarmforge.conf"
  [[ -f "$src/swarmforge/constitution.prompt" ]] \
    && cp "$src/swarmforge/constitution.prompt" "$dest/swarmforge/constitution.prompt"
  rm -rf "$dest/swarmforge/roles"
  cp -R "$src/swarmforge/roles" "$dest/swarmforge/roles"
  mkdir -p "$dest/swarmforge/constitution/articles"
  if [[ -d "$src/swarmforge/constitution/articles" ]]; then
    for pack_article in "$src/swarmforge/constitution/articles"/*; do
      [[ -f "$pack_article" ]] || continue
      article_name="${pack_article:t}"
      case "$article_name" in
        engineering.prompt|workflow.prompt|handoffs.prompt) continue ;;
      esac
      cp "$pack_article" "$dest/swarmforge/constitution/articles/$article_name"
    done
  fi
}

# The lines a pack's language needs git to leave alone, so build output never
# becomes the first commit. A pack branch stays a mirror of upstream, so a
# Forgelet forge carries them here instead, under the pack's own name, and writes
# them where composition reads them: the forge.bb overlay merges a pack's
# `gitignore` into a project's .gitignore without replacing what the project put
# there. Lines are merged rather than copied so a forge-side file that already
# has them stays as it is.
merge_ignore_lines() {
  local src="$1"
  local dest="$2"
  [[ -f "$src" ]] || return 0
  [[ -f "$dest" ]] || : > "$dest"
  local line
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    grep -qxF "$line" "$dest" || printf '%s\n' "$line" >> "$dest"
  done < "$src"
}

install_pack_ignores() {
  local src pack_name
  for src in "$@"; do
    for pack_name in "${pack_names[@]}"; do
      merge_ignore_lines "$src/swarmforge/packs/$pack_name/gitignore" \
                         "packs/$pack_name/gitignore"
    done
  done
}

# The pack's default language, which a project composed from that pack is written
# in unless it says otherwise in its own `swarmforge/language.conf`. It is the
# layer's, so an update refreshes it; the project's own file is the override, and
# the composition seeds that one only when the project has none.
install_pack_languages() {
  local src pack_name language
  for src in "$@"; do
    for pack_name in "${pack_names[@]}"; do
      language="$src/swarmforge/packs/$pack_name/language.conf"
      [[ -f "$language" ]] || continue
      mkdir -p "packs/$pack_name"
      cp "$language" "packs/$pack_name/language.conf"
    done
  done
}

verify_pack_roles() {
  local dest="$1"
  [[ -f "$dest/swarmforge/swarmforge.conf" ]] || fail_missing "$dest/swarmforge/swarmforge.conf"
  while IFS= read -r role; do
    [[ -f "$dest/swarmforge/roles/${role}.prompt" ]] \
      || fail_missing "$dest/swarmforge/roles/${role}.prompt"
  done < <(awk '/^window/ { print $2 }' "$dest/swarmforge/swarmforge.conf")
}

pack_tree() {
  local name="$1"
  if [[ -n "$packs_src" && -d "$packs_src/$name" ]]; then
    echo "$packs_src/$name"
  elif [[ -n "$packs_src" && -f "$packs_src/swarmforge/swarmforge.conf" ]]; then
    echo "$packs_src"
  else
    echo ""
  fi
}

install_project_pack() {
  local pack_src
  pack_src="$(pack_tree "$product")"
  if [[ -z "$pack_src" && -d "$host_dir/.swarmforge/project-pack" ]]; then
    pack_src="$host_dir/.swarmforge/project-pack"
  fi
  [[ -n "$pack_src" && -d "$pack_src" ]] || fail_missing ".swarmforge/project-pack"
  mkdir -p .swarmforge/project-pack
  copy_pack_template "$pack_src" ".swarmforge/project-pack"
  verify_pack_roles ".swarmforge/project-pack"
}

install_named_packs() {
  mkdir -p packs
  local pack_name pack_src
  for pack_name in "${pack_names[@]}"; do
    pack_src="$(pack_tree "$pack_name")"
    if [[ -z "$pack_src" ]]; then
      pack_src="$tmp_dir/packs/$pack_name"
      download_branch "$pack_name" "$pack_src"
    fi
    [[ -n "$pack_src" && -d "$pack_src" ]] || fail_missing "pack $pack_name"
    copy_pack_template "$pack_src" "packs/$pack_name"
    verify_pack_roles "packs/$pack_name"
  done
}

require_files() {
  local required_path
  for required_path in "$@"; do
    [[ -e "$required_path" ]] || fail_missing "$required_path"
  done
}

# A Forgelet forge arrives able to talk to a phone. This fork builds the bridge on
# the machine that will run it - no cross-compilation, no published binaries - and
# installs the tools and rules the bridge's rooms rely on into the forge.
bridge_repo_url="${SWARMFORGE_BRIDGE_REPO:-https://github.com/sgo/forgelet-bridge}"
bridge_ref="${SWARMFORGE_BRIDGE_REF:-master}"
bridge_source="${SWARMFORGE_BRIDGE_DIR:-}"

bridge_tarball() {
  local dest="$1"
  local tar="$tmp_dir/forgelet-bridge.tar.gz"
  local url="${bridge_repo_url}/archive/refs/heads/${bridge_ref}.tar.gz"
  mkdir -p "$dest"
  if ! curl -fsSL "$url" -o "$tar" 2>/dev/null; then
    # A private repository needs a token, and gh has one when it is signed in.
    if command -v gh >/dev/null 2>&1 && gh auth token >/dev/null 2>&1; then
      curl -fsSL -H "Authorization: Bearer $(gh auth token)" "$url" -o "$tar" \
        || fail_missing "the bridge at $url"
    else
      fail_missing "the bridge at $url (make the repository public, or sign in with gh)"
    fi
  fi
  tar -xzf "$tar" --strip-components=1 -C "$dest"
}

build_forgelet_bridge() {
  local dest="$1"
  if [[ -n "$bridge_source" ]]; then
    mkdir -p "$dest"
    cp -R "$bridge_source/." "$dest"
  else
    bridge_tarball "$dest"
  fi
  [[ -f "$dest/scripts/build.sh" ]] || fail_missing "the bridge's build script in $dest"
  command -v go >/dev/null 2>&1 \
    || fail_missing "go (a Forgelet forge builds the bridge it runs)"
  (cd "$dest" && ./scripts/build.sh >/dev/null) || fail_missing "the bridge's build"
}

install_forgelet_bridge() {
  if [[ -n "${SWARMFORGE_SKIP_BRIDGE:-}" ]]; then
    return 0
  fi
  local root="$PWD"
  local installed="projects/forgelet-bridge"
  local source="$tmp_dir/forgelet-bridge"
  # The kit comes from the published bridge, freshly fetched and built, and never
  # from this forge's own projects/forgelet-bridge: that tree is a live project -
  # its own history, its own work in it - while what a forge installs is the code
  # the bridge runs, which is the code the bridge pushes.
  build_forgelet_bridge "$source"
  if [[ ! -d "$installed/.git" ]]; then
    mkdir -p "$installed"
    local part
    for part in build swarmforge rules; do
      [[ -e "$source/$part" ]] || continue
      mkdir -p "$installed/$part"
      cp -R "$source/$part/." "$installed/$part/"
    done
  fi
  if [[ -f "$source/scripts/matrix-bridge.sh" ]]; then
    mkdir -p swarmforge/scripts
    cp "$source/scripts/matrix-bridge.sh" swarmforge/scripts/matrix-bridge.sh
    chmod +x swarmforge/scripts/matrix-bridge.sh
  fi
  local adapter="swarmforge/scripts/matrix-bridge.sh"
  [[ -x "$adapter" ]] || fail_missing "the bridge's adapter at $adapter"
  local kit_binary="$source/build/acceptance/bin/install-kit"
  local kit_dir="$source/swarmforge/scripts"
  local rules_binary="$source/build/acceptance/bin/install-rules"
  local rules_dir="$source/rules"
  local revision=""
  if [[ -d "$source/.git" ]]; then
    revision="$(git -C "$source" rev-parse --short HEAD 2>/dev/null || true)"
  fi
  echo "get-swarm-forge: installing the kit from ${bridge_ref}${revision:+ at $revision}"
  MATRIX_BRIDGE_FORGE_ROOT="$root" \
  MATRIX_BRIDGE_KIT_BINARY="$kit_binary" \
  MATRIX_BRIDGE_KIT="$kit_dir" \
  MATRIX_BRIDGE_RULES_BINARY="$rules_binary" \
  MATRIX_BRIDGE_RULES="$rules_dir" \
    "$adapter" install-kit
  MATRIX_BRIDGE_FORGE_ROOT="$root" \
  MATRIX_BRIDGE_KIT_BINARY="$kit_binary" \
  MATRIX_BRIDGE_KIT="$kit_dir" \
  MATRIX_BRIDGE_RULES_BINARY="$rules_binary" \
  MATRIX_BRIDGE_RULES="$rules_dir" \
    "$adapter" install-rules
}

host_dir="${SWARMFORGE_BASE_DIR:-$tmp_dir/host}"
host_from="$product"
packs_src="${SWARMFORGE_PACKS_DIR:-}"
main_dir="$tmp_dir/main"

if [[ "$product" == two-pack || "$product" == four-pack || "$product" == six-pack ]]; then
  if [[ -z "${SWARMFORGE_BASE_DIR:-}" ]]; then
    download_branch "$base_ref" "$main_dir"
    host_dir="$main_dir"
  fi
  maybe-update-self "$main_dir"
  pack_src="$(pack_tree "$product")"
  if [[ -z "$pack_src" ]]; then
    pack_src="$tmp_dir/pack"
    download_branch "$product" "$pack_src"
  fi
  [[ -n "$pack_src" && -d "$pack_src" ]] || fail_missing "pack $product"
  copy_shared_scripts_and_articles "$host_dir"
  copy_pack_template "$pack_src" "."
  merge_ignore_lines "$host_dir/swarmforge/packs/$product/gitignore" ".gitignore"
  [[ -f swarm ]] || fail_missing "swarm from pack $product"
  chmod +x swarm
  verify_pack_roles "."
  require_files \
    swarm \
    swarmforge/scripts/swarmforge.sh \
    swarmforge/scripts/handoffd.bb \
    swarmforge/scripts/done_with_current.sh \
    swarmforge/constitution/articles/handoffs.prompt \
    swarmforge/constitution/articles/workflow.prompt \
    swarmforge/constitution/articles/engineering.prompt \
    swarmforge/swarmforge.conf \
    swarmforge/constitution.prompt
  echo "SwarmForge pack installed from $product. Run ./swarm to start the pack."
  exit 0
fi

if [[ -z "${SWARMFORGE_BASE_DIR:-}" ]]; then
  download_branch "$product" "$host_dir"
  download_branch "$base_ref" "$main_dir"
fi

maybe-update-self "$main_dir"

mkdir -p projects
copy_host_files "$host_dir"

# A forge product branch carries its own copy of the shared runtime, which is
# whatever it was when that branch was last refreshed. This fork's shared runtime
# is the layer on $base_ref, so it is overlaid last and wins, the way a pack is
# overlaid by the branch that owns the shared files: the product keeps its
# configuration, roles, and scaffolding.
if [[ -z "${SWARMFORGE_BASE_DIR:-}" ]]; then
  copy_shared_scripts_and_articles "$main_dir"
fi

overlay_lieutenant_prompt "$host_dir" "$main_dir"
seed_local_lieutenant_prompt "$host_dir" "$main_dir"

if [[ "$product" == "lieutenant" ]]; then
  install_project_pack
else
  install_named_packs
  install_pack_ignores "$main_dir" "$host_dir"
  install_pack_languages "$main_dir" "$host_dir"
fi

required_files=(
  swarm
  swarmforge/scripts/swarmforge.sh
  swarmforge/scripts/handoffd.bb
  swarmforge/scripts/done_with_current.sh
  swarmforge/constitution/articles/handoffs.prompt
  swarmforge/constitution/articles/workflow.prompt
  swarmforge/constitution/articles/engineering.prompt
  swarmforge/roles/lieutenant.prompt
)

if [[ "$product" == "lieutenant" ]]; then
  required_files+=(.swarmforge/project-pack/swarmforge/swarmforge.conf)
else
  required_files+=(
    packs/two-pack/swarmforge/swarmforge.conf
    packs/four-pack/swarmforge/swarmforge.conf
    packs/six-pack/swarmforge/swarmforge.conf
  )
fi

require_files "${required_files[@]}"

install_forgelet_bridge

echo "SwarmForge forge installed from $host_from. Run ./swarm to start the dashboard."
