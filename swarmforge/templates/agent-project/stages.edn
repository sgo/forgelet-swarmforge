{:task "agent-project"
 :stages
 [{:name "spec"
   :approval :operator
   :spec ["features/*.feature" "tasks/*.md"]
   :stamp ["features" "tasks"]}
  {:name "code"
   :runs [["mvn" "-q" "-Pwith-unit-tests" "verify"]]
   :evidence ["target/surefire-reports/*.xml"]
   :stamp [:sources]}
  {:name "clean"
   :runs [["crap4java" "--test-command" "mvn -q -Pwith-unit-tests test" "."]
          ["dry4java" "--format" "edn" "src/main/java"]]
   :evidence []
   :stamp [:sources]}
  {:name "architect"
   :runs [["mvn" "-q" "-Pwith-unit-tests" "-pl" "architecture" "verify"]]
   :evidence ["ARCHITECTURE.md"]
   :stamp [:sources]}
  {:name "harden"
   :runs [["mvn" "-Pwith-mutation-tests"
           "-DoutputFormats=XML,HTML" "verify"]
          ["scripts/run-acceptance-mutation.sh"]]
   :evidence ["target/pit-reports/mutations.xml"
              "target/acceptance-mutation/mutation.log"]
   :stamp [:features :sources "acceptance"
           "scripts/run-acceptance-tests.sh"
           "scripts/run-acceptance-mutation.sh"]}
  {:name "clean-final"
   :runs [["crap4java" "--test-command" "mvn -q -Pwith-unit-tests test" "."]
          ["dry4java" "--format" "edn" "src/main/java"]]
   :evidence []
   :stamp [:sources]}
  {:name "qa"
   :runs [["mvn" "-q" "-Pwith-property-tests" "verify"]
          ["scripts/run-acceptance-tests.sh"]]
   :evidence ["target/surefire-reports/*.xml"
              "target/acceptance/acceptance.log"]
   :stamp [:features :sources "acceptance" "scripts/run-acceptance-tests.sh"]}
  {:name "e2e"
   :runs [["scripts/run-qa-e2e.sh"]]
   :evidence ["target/e2e/check.log" "qa/e2e.edn" "qa/*.md"
              "scripts/run-qa-*.sh" "scripts/run-qa-e2e.sh"]
   :stamp [:features :sources "qa" "scripts/run-qa-e2e.sh"
           "swarmforge/scripts/check-e2e.bb"]}
  {:name "docs"
   :runs [["scripts/check-documentation.sh"]]
   :evidence ["target/documentation/check.log"]
   :stamp [:features :sources "README.md" "docs" "ARCHITECTURE.md"
           "scripts/check-documentation.sh"
           "swarmforge/scripts/check-documentation.bb"]}
  {:name "deploy"
   :runs [["scripts/install-snapshot.sh"]]
   :evidence []
   :stamp [:sources "scripts/install-snapshot.sh" "pom.xml" ".mvn"]}
  {:name "release"
   :optional true
   :runs [["scripts/release_preflight.sh"]]
   :evidence []
   :stamp ["pom.xml"]}]}
