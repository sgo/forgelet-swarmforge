{:task "agent-project"
 :stages
 [{:name "spec"
   :approval :operator
   :spec ["features/*.feature" "tasks/*.md"]
   :stamp ["features" "tasks"]}
  {:name "code"
   :runs [["scripts/stage-placeholder.sh" "code"]]
   :evidence []
   :stamp [:sources]}
  {:name "clean"
   :runs [["scripts/stage-placeholder.sh" "clean"]]
   :evidence []
   :stamp [:sources]}
  {:name "architect"
   :runs [["scripts/stage-placeholder.sh" "architect"]]
   :evidence []
   :stamp [:sources]}
  {:name "harden"
   :runs [["scripts/stage-placeholder.sh" "harden"]]
   :evidence []
   :stamp [:features :sources]}
  {:name "clean-final"
   :runs [["scripts/stage-placeholder.sh" "clean-final"]]
   :evidence []
   :stamp [:sources]}
  {:name "qa"
   :runs [["scripts/stage-placeholder.sh" "qa"]]
   :evidence []
   :stamp [:features :sources]}
  {:name "e2e"
   :runs [["scripts/stage-placeholder.sh" "e2e"]]
   :evidence []
   :stamp [:features :sources]}
  {:name "docs"
   :runs [["scripts/stage-placeholder.sh" "docs"]]
   :evidence []
   :stamp [:sources "README.md" "docs" "ARCHITECTURE.md"]}
  {:name "deploy"
   :runs [["scripts/stage-placeholder.sh" "deploy"]]
   :evidence []
   :stamp [:sources]}
  {:name "release"
   :optional true
   :runs [["scripts/stage-placeholder.sh" "release"]]
   :evidence []
   :stamp [:sources]}]}
