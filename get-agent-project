#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: get-agent-project <project-name> [--forge <forge-root>] [--profile standard|library]
       get-agent-project --upgrade <project-name-or-path> [--forge <forge-root>] [--check]
       get-agent-project --convert <project-name-or-path> [--forge <forge-root>] [--profile standard|library] [--apply]

Compose a single-agent project into an existing forge. The forge root defaults
to the current directory when it has projects/ and swarmforge/scripts/.

--upgrade applies structural additions to an existing project without
replacing its source, task, feature or existing stage definitions. --check
reports whether the upgrade is still needed and changes nothing.

--convert plans a six-pack project's conversion to one agent. It changes
nothing unless --apply is given.
USAGE
}

fail() {
  printf 'get-agent-project: %s\n' "$*" >&2
  exit 1
}

script_dir="$(cd "$(dirname "$0")" && pwd)"
template_dir="$script_dir/swarmforge/templates/agent-project"
forge_root=""
name=""
profile="standard"
mode=create
check_only=0
apply=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --upgrade)
      mode=upgrade
      shift
      ;;
    --convert)
      mode=convert
      shift
      ;;
    --apply)
      apply=1
      shift
      ;;
    --check)
      check_only=1
      shift
      ;;
    --forge)
      [[ $# -ge 2 ]] || fail "--forge needs a directory"
      forge_root="$2"
      shift 2
      ;;
    --profile)
      [[ $# -ge 2 ]] || fail "--profile needs a name"
      profile="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      fail "unknown option: $1"
      ;;
    *)
      [[ -z "$name" ]] || fail "only one project name is allowed"
      name="$1"
      shift
      ;;
  esac
done

[[ -n "$name" ]] || { usage >&2; exit 1; }
[[ "$name" != *[!A-Za-z0-9._/-]* ]] || fail "project name must be letters, digits, dot, dash, underscore or slash"
[[ -d "$template_dir" ]] || fail "template not found: $template_dir"
case "$profile" in
  standard|library) ;;
  *) fail "unknown profile: $profile (use standard or library)" ;;
esac

if [[ -z "$forge_root" ]]; then
  forge_root="$(pwd)"
fi
forge_root="$(cd "$forge_root" && pwd)" || fail "forge root not found"
[[ -d "$forge_root/projects" ]] || fail "not a forge root (no projects/): $forge_root"
[[ -d "$forge_root/swarmforge/scripts" ]] || fail "not a composed forge (no swarmforge/scripts/): $forge_root"

dest="$forge_root/projects/$name"

if [[ "$mode" == convert ]]; then
  converter="$script_dir/convert-pack-project"
  [[ -x "$converter" ]] || fail "conversion helper not found: $converter"
  convert_root="$name"
  [[ "$name" == */* ]] || convert_root="$dest"
  args=(--root "$convert_root" --forge "$forge_root" --template "$template_dir"
        --profile "$profile")
  [[ "$apply" == 1 ]] && args+=(--apply)
  exec "$converter" "${args[@]}"
fi

if [[ "$mode" == upgrade ]]; then
  [[ "$profile" == standard ]] ||
    fail "--profile is only used when creating a project"
  if [[ "$name" == */* ]]; then
    [[ -d "$name" ]] || fail "project path not found: $name"
    dest="$(cd "$name" && pwd)"
  fi
  [[ -f "$dest/.swarmforge/single-agent" ]] ||
    fail "not a single-agent project: $dest"
  helper="$script_dir/swarmforge/scripts/upgrade-agent-project.bb"
  [[ -f "$helper" ]] || fail "upgrade helper not found: $helper"
  args=(--root "$dest" --template "$template_dir")
  [[ "$check_only" == 1 ]] && args+=(--check)
  exec bb "$helper" "${args[@]}"
fi

[[ "$check_only" == 0 ]] || fail "--check is only valid with --upgrade"
[[ "$apply" == 0 ]] || fail "--apply is only valid with --convert"
[[ ! -e "$dest" ]] || fail "project already exists: $dest"

mkdir -p "$dest"
cp -R "$template_dir/." "$dest/"
if [[ "$profile" == "library" ]]; then
  mv "$dest/stages.library.edn" "$dest/stages.edn"
  mv "$dest/STAGES.library.md" "$dest/STAGES.md"
fi
rm -f "$dest/stages.library.edn" "$dest/STAGES.library.md"
sed "s/:task \"agent-project\"/:task \"$name\"/" "$dest/stages.edn" \
  > "$dest/stages.edn.tmp"
mv "$dest/stages.edn.tmp" "$dest/stages.edn"
mkdir -p "$dest/swarmforge/scripts"
cp -R "$forge_root/swarmforge/scripts/." "$dest/swarmforge/scripts/"
mkdir -p "$dest/swarmforge/constitution/articles"
if [[ -f "$forge_root/swarmforge/constitution/articles/engineering.prompt" ]]; then
  cp "$forge_root/swarmforge/constitution/articles/engineering.prompt" \
     "$dest/swarmforge/constitution/articles/engineering.prompt"
fi
chmod +x "$dest/swarm"
if [[ -f "$dest/scripts/run-acceptance-tests.sh" ]]; then
  chmod +x "$dest/scripts/run-acceptance-tests.sh"
fi
if [[ -f "$dest/scripts/publish-snapshot.sh" ]]; then
  chmod +x "$dest/scripts/publish-snapshot.sh"
fi
if [[ -f "$dest/scripts/github-packages-token.sh" ]]; then
  chmod +x "$dest/scripts/github-packages-token.sh"
fi
if [[ -f "$dest/scripts/check-documentation.sh" ]]; then
  chmod +x "$dest/scripts/check-documentation.sh"
fi
if [[ -f "$dest/scripts/run-qa-e2e.sh" ]]; then
  chmod +x "$dest/scripts/run-qa-e2e.sh"
fi

mkdir -p "$dest/.swarmforge"
printf 'agent\tmaster\t%s\tswarmforge-agent\tAgent\tcodex\ttask\n' "$dest" \
  > "$dest/.swarmforge/roles.tsv"
printf '%s\n' "$name" > "$dest/.swarmforge/single-agent"
printf '%s\n' "$profile" > "$dest/.swarmforge/profile"

if [[ ! -d "$dest/.git" ]]; then
  git init -q "$dest"
  git -C "$dest" branch -M master
  git -C "$dest" add .
  if git -C "$dest" config --get user.name >/dev/null 2>&1 \
     && git -C "$dest" config --get user.email >/dev/null 2>&1; then
    git -C "$dest" commit -q -m "Initial single-agent project"
  else
    git -C "$dest" \
      -c user.name="SwarmForge Scaffold" \
      -c user.email="swarmforge@localhost" \
      commit -q -m "Initial single-agent project"
  fi
fi

installer="$dest/swarmforge/scripts/install-agent-hooks.sh"
if [[ ! -f "$installer" ]]; then
  installer="$script_dir/swarmforge/scripts/install-agent-hooks.sh"
fi
if [[ -f "$installer" ]]; then
  bash "$installer" "$dest"
fi

printf 'Single-agent project created: %s\n' "$dest"
printf 'Profile: %s\n' "$profile"
printf 'Next: %s\n' "$dest/swarm"
